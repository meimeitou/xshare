TUSHARE_TOKEN=your_tushare_token
MINERU_PIPELINE_ID=
# 网络搜索（nanobot 内置 web 工具，可选）
WEB_SEARCH_PROVIDER=tavily # brave / tavily / jina / kagi / olostep / bocha / volcengine / keenable / searxng / duckduckgo
WEB_SEARCH_API_KEY=your_web_search_api_key

# 数据源优先级（可选，数字越小优先级越高）
# TUSHARE_PRIORITY=0
# AKSHARE_PRIORITY=1

# MCP 启动时自动同步（0=关闭 loop 与初次同步，1=开启，默认开启）
# 运行时启停/改间隔请用 sync_job 工具（对话管理，热生效，持久化到 DB）
# XSHARE_AUTO_SYNC=1
# 以下间隔仅在首次初始化时作为种子值写入 DB；之后以 DB 值为准（sync_job 修改后持久）
# 新闻同步间隔（分钟，默认 15）
# XSHARE_NEWS_SYNC_INTERVAL=15
# 股票列表同步间隔（分钟，默认 1440=24小时）
# XSHARE_STOCK_SYNC_INTERVAL=1440
# 日线行情同步间隔（分钟，默认 240=4小时，每日收盘后刷新即可）
# XSHARE_DAILY_SYNC_INTERVAL=240
# 每次日线同步回溯交易日数（默认 1，仅最近一个交易日）
# XSHARE_DAILY_SYNC_DAYS=1
# 启动自检目标交易日数 / 单次补数回溯（默认 252 ≈ 1 年）
# XSHARE_DAILY_MIN_TRADING_DAYS=252
# XSHARE_DAILY_BACKFILL_DAYS=252
# 指数列表同步间隔（分钟，默认 1440）
# XSHARE_INDEX_BASIC_SYNC_INTERVAL=1440
# 指数日线日历任务展示间隔（默认 1440；实际按交易日 16:00）
# XSHARE_INDEX_DAILY_SYNC_INTERVAL=1440
# 指数市场（逗号分隔，默认 SSE,SZSE,CSI）
# XSHARE_INDEX_MARKETS=SSE,SZSE,CSI
# 指数日线覆盖目标 / 补数回溯
# XSHARE_INDEX_DAILY_MIN_TRADING_DAYS=252
# XSHARE_INDEX_DAILY_BACKFILL_DAYS=252
# ETF 列表同步间隔（分钟，默认 1440）
# XSHARE_ETF_BASIC_SYNC_INTERVAL=1440
# ETF 日线日历任务展示间隔（默认 1440；实际按交易日 16:00）
# XSHARE_FUND_DAILY_SYNC_INTERVAL=1440
# ETF 日线覆盖目标 / 补数回溯
# XSHARE_FUND_DAILY_MIN_TRADING_DAYS=252
# XSHARE_FUND_DAILY_BACKFILL_DAYS=252
# 任务队列历史日志保留天数（启动时自动清理，0=关闭）
# XSHARE_SYNC_HISTORY_RETAIN_DAYS=30
# 每次新闻抓取页数（默认 3）
# XSHARE_NEWS_PAGES=3
# 新闻保留天数（默认 1）
# XSHARE_NEWS_RETAIN_DAYS=1
# XSHARE_LOG_LEVEL=INFO
# 同步任务 INFO 日志示例：[sync] daily 2026-07-21 入库 5123 条 → stock_daily
# 日志级别（默认 INFO）
# XSHARE_LOG_LEVEL=INFO

# 本地数据库路径（可选）
# XSHARE_DB_PATH=data/xshare.duckdb          # DuckDB OLAP（行情/财务/新闻）
# XSHARE_SQLITE_PATH=data/xshare.sqlite      # SQLite OLTP（持仓/同步配置/任务队列）

# AI 问股 LLM 配置（OpenAI-compatible API）
XSHARE_LLM_API_BASE=https://api.360.cn/v1
XSHARE_LLM_API_KEY=your_llm_api_key
XSHARE_LLM_MODEL=z-ai/glm-5.2
